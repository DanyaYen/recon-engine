{
  "name": "recon-engine",
  "version": "0.1.0",
  "description": "Lightweight open-source bank statement parser and reconciliation engine",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "recon": "./src/cli/index.ts",
    "recon-engine": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./parsers": "./src/parsers/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./matcher": "./src/matcher/index.ts",
    "./server": "./src/server/index.ts",
    "./mock": "./src/mock/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "build": "bun build ./src/cli/index.ts --outdir ./dist/cli --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "generate:banner": "bun run scripts/generate-banner.tsx",
    "build-video": "remotion render video/index.ts BenchmarkVideo assets/benchmark.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.520",
    "@resvg/resvg-js": "^2.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "elysia": "^1.4.30",
    "fast-xml-parser": "^5.0.8",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.520",
    "satori": "^0.33.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "reconciliation",
    "accounting",
    "bank-statement",
    "camt053",
    "mt940",
    "revolut",
    "stripe",
    "fintech"
  ],
  "license": "MIT"
}
